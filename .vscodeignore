# Editor / IDE
.vscode/**
.vscode-test/**
.idea/**

# Version control / package manager metadata
.gitignore
.github/**
.yarnrc
.yarnrc.yml
.yarn/**

# Source & build config (not needed at runtime if bundled)
src/**
**/*.ts
**/*.map
tsconfig.json
.eslintrc*
vsc-extension-quickstart.md

# Dependencies (keep only what's actually required at runtime)
node_modules/**
!node_modules/@hyrious/**

# Misc
*.log